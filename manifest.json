{
  "manifest_version": 3,
  "name": "帖子图床提取器",
  "version": "1.4.1",
  "description": "支持 4KHD 搜索和 mtldss 标签页，按人物和帖子分类下载正文图片，失败时自动重试。",
  "minimum_chrome_version": "109",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://hecoq.uuss.uk/*",
    "https://www.4khd.com/*",
    "https://4khd.com/*",
    "https://mtldss.top/*",
    "https://www.mtldss.top/*",
    "https://img.mtldss.top/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "打开帖子图床提取器",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": { "service_worker": "background.js" }
}